# Whitelist only the folders we want to track
/*
!/.gitignore
!/Streaker Detect/
!/Get_TLE/
!/Record/
!/Sat_Calcs/
!/Streaker_Display/

# Streaker Detect — exclude build artifacts and generated output
/Streaker Detect/build/
/Streaker Detect/dist/
/Streaker Detect/bin/
/Streaker Detect/__pycache__/
/Streaker Detect/*.pyc
/Streaker Detect/synth_test_results/
/Streaker Detect/compare_results/
/Streaker Detect/event_*/
/Streaker Detect/clips_*/
/Streaker Detect/*.log
/Streaker Detect/streaker_config.json
/Streaker Detect/shared_config.json
/Streaker Detect/streaker_astro_config.json

# Get_TLE — exclude credentials, downloaded TLE data, and logs
/Get_TLE/tle_config.json
/Get_TLE/TLEz/
/Get_TLE/*.log

# Record — exclude credentials, build artifacts, and logs
/Record/stream_capture_config.json
/Record/stream_capture_config_cam2.json
/Record/logs/
/Record/bin/
/Record/build/
/Record/dist/
/Record/python/
/Record/__pycache__/
/Record/*.pyc

# Sat_Calcs — exclude cache
/Sat_Calcs/__pycache__/
/Sat_Calcs/*.pyc

# Streaker_Display — exclude credentials, build artifacts, and logs
/Streaker_Display/streaker_display_config.json
/Streaker_Display/build/
/Streaker_Display/dist/
/Streaker_Display/__pycache__/
/Streaker_Display/*.pyc
/Streaker_Display/*.log
